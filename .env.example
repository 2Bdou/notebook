# SQLite 数据库文件路径（容器内）
DB_PATH=/app/data/notebook.db

# JWT 密钥（生产环境务必修改为随机字符串）
SECRET_KEY=notebook-secret-key-change-in-production

# Token 过期时间（分钟），默认 10080（7天）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ====== 注册安全控制 ======

# 是否开放注册（false 时注册接口拒绝，需管理员手动建账号）
ALLOW_REGISTRATION=true

# 注册邀请码（留空表示不需要邀请码；设置后注册必须提供正确码）
REGISTRATION_CODE=

# 单 IP 每小时最多注册次数（防同一 IP 批量注册）
REGISTRATION_IP_HOURLY_LIMIT=3

# 认证接口全局速率限制（每分钟最大请求数，防暴力破解）
AUTH_RATE_LIMIT_PER_MINUTE=20
